import android.text.TextUtils
import android.widget.Button
import android.widget.RadioButton
import android.widget.RadioGroup
import android.widget.SeekBar
import android.widget.TextView
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity
import androidx.appcompat.widget.SwitchCompat

class MainActivity : AppCompatActivity() {

    private lateinit var prefs: android.content.SharedPreferences

    private lateinit var switchMasterService: SwitchCompat
    private lateinit var tvOverlayStatus: TextView
    private lateinit var btnGrantOverlay: Button
    private lateinit var tvDndStatus: TextView
    private lateinit var btnGrantDnd: Button
    private lateinit var tvBatteryStatus: TextView
    private lateinit var btnGrantBattery: Button
    private lateinit var tvAccessibilityStatus: TextView
    private lateinit var btnGrantAccessibility: Button

    private lateinit var rgButtonSize: RadioGroup
    private lateinit var rbSizeSmall: RadioButton
    private lateinit var rbSizeMedium: RadioButton
    private lateinit var rbSizeLarge: RadioButton

    private lateinit var seekIdleOpacity: SeekBar
    private lateinit var tvIdleOpacityValue: TextView

    private lateinit var rgThemeAccent: RadioGroup
    private lateinit var rbThemeDark: RadioButton
    private lateinit var rbThemeLight: RadioButton
    private lateinit var rbThemeSystem: RadioButton

    private lateinit var btnTriggerPanelNow: Button

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        prefs = getSharedPreferences(FloatingVolumeService.PREFS_NAME, Context.MODE_PRIVATE)

        bindViews()
        loadSavedPreferences()
        setupListeners()
    }

    override fun onResume() {
        super.onResume()
        updatePermissionChecklistUI()
        syncServiceSwitchState()
    }

    private fun bindViews() {
        switchMasterService = findViewById(R.id.switchMasterService)

        tvOverlayStatus = findViewById(R.id.tvOverlayStatus)
        btnGrantOverlay = findViewById(R.id.btnGrantOverlay)

        tvDndStatus = findViewById(R.id.tvDndStatus)
        btnGrantDnd = findViewById(R.id.btnGrantDnd)

        tvBatteryStatus = findViewById(R.id.tvBatteryStatus)
        btnGrantBattery = findViewById(R.id.btnGrantBattery)

        tvAccessibilityStatus = findViewById(R.id.tvAccessibilityStatus)
        btnGrantAccessibility = findViewById(R.id.btnGrantAccessibility)

        rgButtonSize = findViewById(R.id.rgButtonSize)
        rbSizeSmall = findViewById(R.id.rbSizeSmall)
        rbSizeMedium = findViewById(R.id.rbSizeMedium)
        rbSizeLarge = findViewById(R.id.rbSizeLarge)

        seekIdleOpacity = findViewById(R.id.seekIdleOpacity)
        tvIdleOpacityValue = findViewById(R.id.tvIdleOpacityValue)

        rgThemeAccent = findViewById(R.id.rgThemeAccent)
        rbThemeDark = findViewById(R.id.rbThemeDark)
        rbThemeLight = findViewById(R.id.rbThemeLight)
        rbThemeSystem = findViewById(R.id.rbThemeSystem)

        btnTriggerPanelNow = findViewById(R.id.btnTriggerPanelNow)
    }

    private fun loadSavedPreferences() {
        when (prefs.getInt(FloatingVolumeService.KEY_BUTTON_SIZE, 1)) {
            0 -> rbSizeSmall.isChecked = true
            1 -> rbSizeMedium.isChecked = true
            2 -> rbSizeLarge.isChecked = true
        }

        val savedOpacity = prefs.getInt(FloatingVolumeService.KEY_IDLE_OPACITY, 30).coerceIn(10, 100)
        seekIdleOpacity.max = 90
        seekIdleOpacity.progress = savedOpacity - 10
        tvIdleOpacityValue.text = "$savedOpacity%"

        when (prefs.getInt(FloatingVolumeService.KEY_THEME_MODE, 2)) {
            0 -> rbThemeDark.isChecked = true
            1 -> rbThemeLight.isChecked = true
            2 -> rbThemeSystem.isChecked = true
        }
    }

    private fun setupListeners() {
        switchMasterService.setOnCheckedChangeListener { buttonView, isChecked ->
            if (!buttonView.isPressed) return@setOnCheckedChangeListener

            if (isChecked) {
                if (!Settings.canDrawOverlays(this)) {
                    switchMasterService.isChecked = false
                    Toast.makeText(
                        this,
                        "Please grant 'Display over other apps' permission first.",
                        Toast.LENGTH_LONG
                    ).show()
                    requestOverlayPermission()
                    return@setOnCheckedChangeListener
                }
                prefs.edit().putBoolean(FloatingVolumeService.KEY_SERVICE_ENABLED, true).apply()
                startFloatingService(FloatingVolumeService.ACTION_START)
            } else {
                prefs.edit().putBoolean(FloatingVolumeService.KEY_SERVICE_ENABLED, false).apply()
                stopService(Intent(this, FloatingVolumeService::class.java))
            }
        }

        btnGrantOverlay.setOnClickListener {
            requestOverlayPermission()
        }

        btnGrantDnd.setOnClickListener {
            val intent = Intent(Settings.ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS)
            startActivity(intent)
        }

        btnGrantBattery.setOnClickListener {
            requestIgnoreBatteryOptimizations()
        }

        btnGrantAccessibility.setOnClickListener {
            val intent = Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)
            startActivity(intent)
        }

        rgButtonSize.setOnCheckedChangeListener { _, checkedId ->
            val sizeIndex = when (checkedId) {
                R.id.rbSizeSmall -> 0
                R.id.rbSizeLarge -> 2
                else -> 1
            }
            prefs.edit().putInt(FloatingVolumeService.KEY_BUTTON_SIZE, sizeIndex).apply()
            notifyServiceConfigChanged()
        }

        seekIdleOpacity.setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
            override fun onProgressChanged(seekBar: SeekBar?, progress: Int, fromUser: Boolean) {
                val actualPercent = (progress + 10).coerceIn(10, 100)
                tvIdleOpacityValue.text = "$actualPercent%"
                if (fromUser) {
                    prefs.edit().putInt(FloatingVolumeService.KEY_IDLE_OPACITY, actualPercent).apply()
                    notifyServiceConfigChanged()
                }
            }

            override fun onStartTrackingTouch(seekBar: SeekBar?) {}
            override fun onStopTrackingTouch(seekBar: SeekBar?) {}
        })

        rgThemeAccent.setOnCheckedChangeListener { _, checkedId ->
            val themeMode = when (checkedId) {
                R.id.rbThemeDark -> 0
                R.id.rbThemeLight -> 1
                else -> 2
            }
            prefs.edit().putInt(FloatingVolumeService.KEY_THEME_MODE, themeMode).apply()
            notifyServiceConfigChanged()
        }

        btnTriggerPanelNow.setOnClickListener {
            if (!Settings.canDrawOverlays(this)) {
                Toast.makeText(
                    this,
                    "Grant 'Display over other apps' permission first.",
                    Toast.LENGTH_SHORT
                ).show()
                requestOverlayPermission()
                return@setOnClickListener
            }
            prefs.edit().putBoolean(FloatingVolumeService.KEY_SERVICE_ENABLED, true).apply()
            switchMasterService.isChecked = true
            startFloatingService(FloatingVolumeService.ACTION_EXPAND_PANEL)
        }
    }

    private fun updatePermissionChecklistUI() {
        val hasOverlay = Settings.canDrawOverlays(this)
        if (hasOverlay) {
            tvOverlayStatus.text = "Granted"
            tvOverlayStatus.setTextColor(Color.parseColor("#2E7D32"))
            btnGrantOverlay.text = "Configured"
            btnGrantOverlay.isEnabled = false
        } else {
            tvOverlayStatus.text = "Required"
            tvOverlayStatus.setTextColor(Color.parseColor("#C62828"))
            btnGrantOverlay.text = "Grant"
            btnGrantOverlay.isEnabled = true
        }

        val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
        val hasDnd = nm.isNotificationPolicyAccessGranted
        if (hasDnd) {
            tvDndStatus.text = "Granted"
            tvDndStatus.setTextColor(Color.parseColor("#2E7D32"))
            btnGrantDnd.text = "Configured"
            btnGrantDnd.isEnabled = false
        } else {
            tvDndStatus.text = "Required for Mute/DND"
            tvDndStatus.setTextColor(Color.parseColor("#EF6C00"))
            btnGrantDnd.text = "Grant"
            btnGrantDnd.isEnabled = true
        }

        val pm = getSystemService(Context.POWER_SERVICE) as PowerManager
        val isIgnoringBattery = pm.isIgnoringBatteryOptimizations(packageName)
        if (isIgnoringBattery) {
            tvBatteryStatus.text = "Unrestricted"
            tvBatteryStatus.setTextColor(Color.parseColor("#2E7D32"))
            btnGrantBattery.text = "Configured"
            btnGrantBattery.isEnabled = false
        } else {
            tvBatteryStatus.text = "Optimized (May Close)"
            tvBatteryStatus.setTextColor(Color.parseColor("#EF6C00"))
            btnGrantBattery.text = "Disable"
            btnGrantBattery.isEnabled = true
        }

        val hasAccessibility = isAccessibilityServiceEnabled()
        if (hasAccessibility) {
            tvAccessibilityStatus.text = "Enabled (Background Volume Unlocked)"
            tvAccessibilityStatus.setTextColor(Color.parseColor("#2E7D32"))
            btnGrantAccessibility.text = "Configured"
            btnGrantAccessibility.isEnabled = false
        } else {
            tvAccessibilityStatus.text = "Recommended if sliders don't change volume outside app"
            tvAccessibilityStatus.setTextColor(Color.parseColor("#EF6C00"))
            btnGrantAccessibility.text = "Enable"
            btnGrantAccessibility.isEnabled = true
        }
    }

    private fun isAccessibilityServiceEnabled(): Boolean {
        val expectedComponent = ComponentName(this, VolumeAccessibilityService::class.java)
        val enabledServices = Settings.Secure.getString(
            contentResolver,
            Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES
        ) ?: return false

        val splitter = TextUtils.SimpleStringSplitter(':')
        splitter.setString(enabledServices)
        while (splitter.hasNext()) {
            val componentStr = splitter.next()
            val enabledComponent = ComponentName.unflattenFromString(componentStr)
            if (enabledComponent != null && enabledComponent == expectedComponent) {
                return true
            }
        }
        return false
    }

    private fun syncServiceSwitchState() {
        val hasOverlay = Settings.canDrawOverlays(this)
        val serviceEnabled = prefs.getBoolean(FloatingVolumeService.KEY_SERVICE_ENABLED, false)
        switchMasterService.isChecked = hasOverlay && serviceEnabled

        if (hasOverlay && serviceEnabled) {
            startFloatingService(FloatingVolumeService.ACTION_START)
        }
    }

    private fun requestOverlayPermission() {
        val intent = Intent(
            Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
            Uri.parse("package:$packageName")
        )
        startActivity(intent)
    }

    private fun requestIgnoreBatteryOptimizations() {
        try {
            val intent = Intent(
                Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS,
                Uri.parse("package:$packageName")
            )
            startActivity(intent)
        } catch (e: Exception) {
            val fallbackIntent = Intent(Settings.ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS)
            startActivity(fallbackIntent)
        }
    }

    private fun notifyServiceConfigChanged() {
        if (Settings.canDrawOverlays(this) &&
            prefs.getBoolean(FloatingVolumeService.KEY_SERVICE_ENABLED, false)
        ) {
            startFloatingService(FloatingVolumeService.ACTION_UPDATE_CONFIG)
        }
    }

    private fun startFloatingService(action: String) {
        val intent = Intent(this, FloatingVolumeService::class.java).apply {
            this.action = action
        }
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            startForegroundService(intent)
        } else {
            startService(intent)
        }
    }
}
