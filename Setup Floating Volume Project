package com.lightweight.floatingvolume

import android.content.BroadcastReceiver
import android.content.Context
import android.content.Intent
import android.os.Build
import android.provider.Settings

class BootReceiver : BroadcastReceiver() {

    override fun onReceive(context: Context, intent: Intent) {
        val action = intent.action ?: return
        if (action == Intent.ACTION_BOOT_COMPLETED ||
            action == Intent.ACTION_LOCKED_BOOT_COMPLETED ||
            action == "android.intent.action.QUICKBOOT_POWERON"
        ) {
            val prefs = context.getSharedPreferences(
                FloatingVolumeService.PREFS_NAME,
                Context.MODE_PRIVATE
            )
            val isEnabled = prefs.getBoolean(FloatingVolumeService.KEY_SERVICE_ENABLED, true)

            if (isEnabled && Settings.canDrawOverlays(context)) {
                val serviceIntent = Intent(context, FloatingVolumeService::class.java).apply {
                    this.action = FloatingVolumeService.ACTION_START
                }
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                    context.startForegroundService(serviceIntent)
                } else {
                    context.startService(serviceIntent)
                }
            }
        }
    }
}
