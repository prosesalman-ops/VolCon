package com.lightweight.floatingvolume

import android.accessibilityservice.AccessibilityService
import android.content.Context
import android.media.AudioManager
import android.view.accessibility.AccessibilityEvent

class VolumeAccessibilityService : AccessibilityService() {

    companion object {
        @Volatile
        var instance: VolumeAccessibilityService? = null
            private set

        fun setVolumePrivileged(
            fallbackContext: Context,
            streamType: Int,
            targetIndex: Int,
            showSystemUiPopup: Boolean = false
        ) {
            val activeContext = instance ?: fallbackContext
            val am = activeContext.getSystemService(Context.AUDIO_SERVICE) as AudioManager
            val flags = if (showSystemUiPopup) AudioManager.FLAG_SHOW_UI else 0

            // 1. Attempt direct volume index assignment from elevated context
            am.setStreamVolume(streamType, targetIndex, flags)

            // 2. If the OEM or background hardening ignored setStreamVolume, step-adjust using adjustStreamVolume
            var current = am.getStreamVolume(streamType)
            if (current != targetIndex) {
                val maxSteps = 25
                var steps = 0
                while (current != targetIndex && steps < maxSteps) {
                    val direction = if (targetIndex > current) {
                        AudioManager.ADJUST_RAISE
                    } else {
                        AudioManager.ADJUST_LOWER
                    }
                    am.adjustStreamVolume(streamType, direction, flags)
                    val updated = am.getStreamVolume(streamType)
                    if (updated == current) break
                    current = updated
                    steps++
                }
            }
        }
    }

    override fun onServiceConnected() {
        super.onServiceConnected()
        instance = this
    }

    override fun onAccessibilityEvent(event: AccessibilityEvent?) {
        // No screen inspection needed; only provides privileged system context for background volume control
    }

    override fun onInterrupt() {}

    override fun onDestroy() {
        if (instance === this) {
            instance = null
        }
        super.onDestroy()
    }
}
