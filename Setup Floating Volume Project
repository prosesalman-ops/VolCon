    @SuppressLint("ClickableViewAccessibility")
    private fun setupBubbleDragAndTapPhysics() {
        var initialParamX = 0
        var initialParamY = 0
        var initialTouchX = 0f
        var initialTouchY = 0f
        var isDragging = false
        val touchSlopPx = dpToPx(CLICK_DRAG_TOLERANCE_DP)

        bubbleContainer.setOnTouchListener { _, event ->
            when (event.actionMasked) {
                MotionEvent.ACTION_DOWN -> {
                    snapAnimator?.cancel()
                    wakeUpBubbleAndScheduleFade()
                    initialParamX = layoutParams.x
                    initialParamY = layoutParams.y
                    initialTouchX = event.rawX
                    initialTouchY = event.rawY
                    isDragging = false
                    true
                }

                MotionEvent.ACTION_MOVE -> {
                    val dx = (event.rawX - initialTouchX).toInt()
                    val dy = (event.rawY - initialTouchY).toInt()
                    if (abs(dx) > touchSlopPx || abs(dy) > touchSlopPx) {
                        isDragging = true
                    }
                    if (isDragging) {
                        val (screenWidth, screenHeight) = getScreenSize()
                        val maxX = (screenWidth - bubbleContainer.width).coerceAtLeast(0)
                        val maxY = (screenHeight - bubbleContainer.height).coerceAtLeast(0)

                        layoutParams.x = (initialParamX + dx).coerceIn(0, maxX)
                        layoutParams.y = (initialParamY + dy).coerceIn(0, maxY)
                        safeUpdateViewLayout()
                    }
                    true
                }

                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
                    if (!isDragging) {
                        expandVolumePanel()
                    } else {
                        snapBubbleToNearestEdge()
                    }
                    true
                }

                else -> false
            }
        }
    }

    private fun snapBubbleToNearestEdge() {
        val (screenWidth, _) = getScreenSize()
        val bubbleWidth = bubbleContainer.width.takeIf { it > 0 } ?: dpToPx(56f)
        val currentX = layoutParams.x
        val centerX = currentX + bubbleWidth / 2

        val targetX = if (centerX < screenWidth / 2) {
            0
        } else {
            (screenWidth - bubbleWidth).coerceAtLeast(0)
        }

        snapAnimator?.cancel()
        snapAnimator = ValueAnimator.ofInt(currentX, targetX).apply {
            duration = 220L
            interpolator = DecelerateInterpolator()
            addUpdateListener { animator ->
                layoutParams.x = animator.animatedValue as Int
                safeUpdateViewLayout()
            }
            start()
        }

        prefs.edit()
            .putInt(KEY_SAVED_X, targetX)
            .putInt(KEY_SAVED_Y, layoutParams.y)
            .apply()

        wakeUpBubbleAndScheduleFade()
    }

    private fun setupVolumeSliders() {
        bindStreamSeekBar(
            seekBar = seekMedia,
            valueLabel = tvMediaVal,
            streamType = AudioManager.STREAM_MUSIC
        )

        bindStreamSeekBar(
            seekBar = seekRing,
            valueLabel = tvRingVal,
            streamType = AudioManager.STREAM_RING,
            mirrorNotificationStream = true
        )

        bindStreamSeekBar(
            seekBar = seekAlarm,
            valueLabel = tvAlarmVal,
            streamType = AudioManager.STREAM_ALARM
        )

        bindStreamSeekBar(
            seekBar = seekVoice,
            valueLabel = tvVoiceVal,
            streamType = AudioManager.STREAM_VOICE_CALL
        )
    }

    private fun bindStreamSeekBar(
        seekBar: SeekBar,
        valueLabel: TextView,
        streamType: Int,
        mirrorNotificationStream: Boolean = false
    ) {
        val maxVol = audioManager.getStreamMaxVolume(streamType).coerceAtLeast(1)
        seekBar.max = maxVol

        seekBar.setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
            override fun onProgressChanged(sb: SeekBar?, progress: Int, fromUser: Boolean) {
                val pct = ((progress.toFloat() / maxVol.toFloat()) * 100f).toInt().coerceIn(0, 100)
                valueLabel.text = "$pct%"

                if (fromUser) {
                    resetPanelAutoDismissTimer()
                    try {
                        VolumeAccessibilityService.setVolumePrivileged(
                            fallbackContext = this@FloatingVolumeService,
                            streamType = streamType,
                            targetIndex = progress,
                            showSystemUiPopup = false
                        )
                        if (mirrorNotificationStream) {
                            val maxNotif = audioManager.getStreamMaxVolume(AudioManager.STREAM_NOTIFICATION)
                            val scaledNotif = ((progress.toFloat() / maxVol.toFloat()) * maxNotif).toInt()
                            VolumeAccessibilityService.setVolumePrivileged(
                                fallbackContext = this@FloatingVolumeService,
                                streamType = AudioManager.STREAM_NOTIFICATION,
                                targetIndex = scaledNotif,
                                showSystemUiPopup = false
                            )
                        }
                        updateQuickToggleButtonsUI()
                    } catch (secEx: SecurityException) {
                        promptDndPermissionToast()
                    }
                }
            }

            override fun onStartTrackingTouch(sb: SeekBar?) {
                isUserDraggingSlider = true
                mainHandler.removeCallbacks(autoDismissPanelRunnable)
            }

            override fun onStopTrackingTouch(sb: SeekBar?) {
                isUserDraggingSlider = false
                resetPanelAutoDismissTimer()
            }
        })
    }

    private fun setupQuickActionToggles() {
        btnRingerMode.setOnClickListener {
            resetPanelAutoDismissTimer()
            val nextMode = when (audioManager.ringerMode) {
                AudioManager.RINGER_MODE_NORMAL -> AudioManager.RINGER_MODE_VIBRATE
                AudioManager.RINGER_MODE_VIBRATE -> AudioManager.RINGER_MODE_SILENT
                else -> AudioManager.RINGER_MODE_NORMAL
            }

            if (nextMode == AudioManager.RINGER_MODE_SILENT &&
                !notificationManager.isNotificationPolicyAccessGranted
            ) {
                promptDndPermissionToast()
                openDndSettings()
                return@setOnClickListener
            }

            try {
                val activeContext = VolumeAccessibilityService.instance ?: this
                val am = activeContext.getSystemService(Context.AUDIO_SERVICE) as AudioManager
                am.ringerMode = nextMode
                syncAllSlidersWithSystem()
                updateQuickToggleButtonsUI()
            } catch (e: SecurityException) {
                promptDndPermissionToast()
                openDndSettings()
            }
        }

        btnDndToggle.setOnClickListener {
            resetPanelAutoDismissTimer()
            if (!notificationManager.isNotificationPolicyAccessGranted) {
                promptDndPermissionToast()
                openDndSettings()
                return@setOnClickListener
            }

            val currentFilter = notificationManager.currentInterruptionFilter
            val newFilter = if (currentFilter == NotificationManager.INTERRUPTION_FILTER_ALL) {
                NotificationManager.INTERRUPTION_FILTER_PRIORITY
            } else {
                NotificationManager.INTERRUPTION_FILTER_ALL
            }

            try {
                notificationManager.setInterruptionFilter(newFilter)
                updateQuickToggleButtonsUI()
            } catch (e: SecurityException) {
                promptDndPermissionToast()
            }
        }
    }

    @SuppressLint("ClickableViewAccessibility")
    private fun setupOutsideTouchAutoDismiss(rootView: View) {
        rootView.setOnTouchListener { _, event ->
            if (isPanelExpanded && event.actionMasked == MotionEvent.ACTION_OUTSIDE) {
                collapseVolumePanel()
                true
            } else {
                false
            }
        }
    }

    private fun expandVolumePanel() {
        if (rootOverlayView == null) return
        mainHandler.removeCallbacks(idleFadeRunnable)

        isPanelExpanded = true
        syncAllSlidersWithSystem()
        updateQuickToggleButtonsUI()

        bubbleContainer.visibility = View.GONE
        panelCard.visibility = View.VISIBLE
        panelCard.alpha = 0f
        panelCard.scaleX = 0.92f
        panelCard.scaleY = 0.92f

        val (screenWidth, screenHeight) = getScreenSize()
        val panelWidthPx = dpToPx(296f)
        val panelHeightPx = dpToPx(330f)

        // Make expanded panel focusable while open so Android grants foreground audio control privilege
        layoutParams.flags = (layoutParams.flags and WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE.inv()) or
                WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or
                WindowManager.LayoutParams.FLAG_WATCH_OUTSIDE_TOUCH

        layoutParams.x = ((screenWidth - panelWidthPx) / 2).coerceAtLeast(dpToPx(12f))
        layoutParams.y = layoutParams.y.coerceIn(
            dpToPx(32f),
            (screenHeight - panelHeightPx - dpToPx(32f)).coerceAtLeast(dpToPx(32f))
        )
        safeUpdateViewLayout()

        panelCard.animate()
            .alpha(1f)
            .scaleX(1f)
            .scaleY(1f)
            .setDuration(180L)
            .start()

        resetPanelAutoDismissTimer()
    }

    private fun collapseVolumePanel() {
        if (!isPanelExpanded || rootOverlayView == null) return
        mainHandler.removeCallbacks(autoDismissPanelRunnable)
        isPanelExpanded = false
        isUserDraggingSlider = false

        panelCard.visibility = View.GONE
        bubbleContainer.visibility = View.VISIBLE

        layoutParams.flags = layoutParams.flags or WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE

        val (screenWidth, screenHeight) = getScreenSize()
        val savedX = prefs.getInt(KEY_SAVED_X, screenWidth - dpToPx(56f))
        val savedY = prefs.getInt(KEY_SAVED_Y, screenHeight / 3)

        layoutParams.x = savedX.coerceIn(0, screenWidth - dpToPx(44f))
        layoutParams.y = savedY.coerceIn(0, screenHeight - dpToPx(68f))
        safeUpdateViewLayout()

        wakeUpBubbleAndScheduleFade()
    }

    private fun syncAllSlidersWithSystem() {
        updateSingleSlider(seekMedia, tvMediaVal, AudioManager.STREAM_MUSIC)
        updateSingleSlider(seekRing, tvRingVal, AudioManager.STREAM_RING)
        updateSingleSlider(seekAlarm, tvAlarmVal, AudioManager.STREAM_ALARM)
        updateSingleSlider(seekVoice, tvVoiceVal, AudioManager.STREAM_VOICE_CALL)
    }

    private fun updateSingleSlider(seekBar: SeekBar, label: TextView, streamType: Int) {
        val max = audioManager.getStreamMaxVolume(streamType).coerceAtLeast(1)
        val cur = audioManager.getStreamVolume(streamType).coerceIn(0, max)
        seekBar.max = max
        seekBar.progress = cur
        val pct = ((cur.toFloat() / max.toFloat()) * 100f).toInt().coerceIn(0, 100)
        label.text = "$pct%"
    }

    private fun updateQuickToggleButtonsUI() {
        when (audioManager.ringerMode) {
            AudioManager.RINGER_MODE_SILENT -> {
                btnRingerMode.text = "Mode: Silent"
            }
            AudioManager.RINGER_MODE_VIBRATE -> {
                btnRingerMode.text = "Mode: Vibrate"
            }
            else -> {
                btnRingerMode.text = "Mode: Ring"
            }
        }

        val isDndActive =
            notificationManager.currentInterruptionFilter != NotificationManager.INTERRUPTION_FILTER_ALL
        btnDndToggle.text = if (isDndActive) "DND: ON" else "DND: OFF"
    }

    private fun applyUserCustomizations() {
        if (rootOverlayView == null) return

        val sizeOption = prefs.getInt(KEY_BUTTON_SIZE, 1)
        val sizeDp = when (sizeOption) {
            0 -> 44f
            2 -> 68f
            else -> 56f
        }
        val sizePx = dpToPx(sizeDp)
        val bubbleLp = bubbleContainer.layoutParams
        bubbleLp.width = sizePx
        bubbleLp.height = sizePx
        bubbleContainer.layoutParams = bubbleLp

        val opacityPercent = prefs.getInt(KEY_IDLE_OPACITY, 30).coerceIn(10, 100)
        idleAlphaFraction = opacityPercent / 100f

        val themePref = prefs.getInt(KEY_THEME_MODE, 2)
        val useLightMode = when (themePref) {
            0 -> false
            1 -> true
            else -> {
                val nightFlags = resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK
                nightFlags != Configuration.UI_MODE_NIGHT_YES
            }
        }

        val bubbleBgColor = if (useLightMode) Color.parseColor("#E6FFFFFF") else Color.parseColor("#E6212121")
        val bubbleStrokeColor = if (useLightMode) Color.parseColor("#33000000") else Color.parseColor("#4DFFFFFF")
        val iconTint = if (useLightMode) Color.parseColor("#1E88E5") else Color.parseColor("#90CAF9")

        val bubbleDrawable = GradientDrawable().apply {
            shape = GradientDrawable.OVAL
            setColor(bubbleBgColor)
            setStroke(dpToPx(1.5f), bubbleStrokeColor)
        }
        bubbleContainer.background = bubbleDrawable
        ivBubbleIcon.setColorFilter(iconTint)

        val panelBgColor = if (useLightMode) Color.parseColor("#F7FFFFFF") else Color.parseColor("#F21E1E1E")
        val primaryTextColor = if (useLightMode) Color.parseColor("#1C1B1F") else Color.parseColor("#F5F5F5")
        val secondaryTextColor = if (useLightMode) Color.parseColor("#49454F") else Color.parseColor("#CAC4D0")

        val panelDrawable = GradientDrawable().apply {
            shape = GradientDrawable.RECTANGLE
            cornerRadius = dpToPx(20f).toFloat()
            setColor(panelBgColor)
            setStroke(dpToPx(1f), bubbleStrokeColor)
        }
        panelCard.background = panelDrawable

        tvPanelTitle.setTextColor(primaryTextColor)
        tvLabelMedia.setTextColor(secondaryTextColor)
        tvLabelRing.setTextColor(secondaryTextColor)
        tvLabelAlarm.setTextColor(secondaryTextColor)
        tvLabelVoice.setTextColor(secondaryTextColor)

        tvMediaVal.setTextColor(primaryTextColor)
        tvRingVal.setTextColor(primaryTextColor)
        tvAlarmVal.setTextColor(primaryTextColor)
        tvVoiceVal.setTextColor(primaryTextColor)

        wakeUpBubbleAndScheduleFade()
    }

    private fun wakeUpBubbleAndScheduleFade() {
        mainHandler.removeCallbacks(idleFadeRunnable)
        bubbleContainer.animate().cancel()
        bubbleContainer.alpha = 1.0f
        mainHandler.postDelayed(idleFadeRunnable, IDLE_FADE_DELAY_MS)
    }

    private fun resetPanelAutoDismissTimer() {
        mainHandler.removeCallbacks(autoDismissPanelRunnable)
        mainHandler.postDelayed(autoDismissPanelRunnable, PANEL_AUTO_DISMISS_MS)
    }

    private fun promptDndPermissionToast() {
        Toast.makeText(
            this,
            "Grant 'Do Not Disturb Access' to toggle Silent/DND mode.",
            Toast.LENGTH_SHORT
        ).show()
    }

    private fun openDndSettings() {
        collapseVolumePanel()
        val intent = Intent(Settings.ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS).apply {
            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
        }
        startActivity(intent)
    }

    private fun safeUpdateViewLayout() {
        val view = rootOverlayView ?: return
        if (view.isAttachedToWindow) {
            try {
                windowManager.updateViewLayout(view, layoutParams)
            } catch (_: IllegalArgumentException) {
            }
        }
    }

    private fun getScreenSize(): Pair<Int, Int> {
        return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
            val metrics = windowManager.currentWindowMetrics
            val bounds = metrics.bounds
            Pair(bounds.width(), bounds.height())
        } else {
            val dm = DisplayMetrics()
            @Suppress("DEPRECATION")
            windowManager.defaultDisplay.getRealMetrics(dm)
            Pair(dm.widthPixels, dm.heightPixels)
        }
    }

    private fun dpToPx(dp: Float): Int {
        return TypedValue.applyDimension(
            TypedValue.COMPLEX_UNIT_DIP,
            dp,
            resources.displayMetrics
        ).toInt()
    }

    override fun onDestroy() {
        isRunning = false
        mainHandler.removeCallbacksAndMessages(null)
        snapAnimator?.cancel()
        try {
            unregisterReceiver(systemAudioReceiver)
        } catch (_: Exception) {
        }
        rootOverlayView?.let { view ->
            if (view.isAttachedToWindow) {
                windowManager.removeView(view)
            }
        }
        rootOverlayView = null
        super.onDestroy()
    }
}
